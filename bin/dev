#!/usr/bin/env bash
# bin/dev - Единый лаунчер сценариев devtool

set -e

# Определение базовой директории репозитория (даже при запуске через symlink)
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DEV_ROOT_DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"
export DEV_ROOT_DIR

# Загрузка утилит
# shellcheck source=lib/utils.sh
source "$DEV_ROOT_DIR/lib/utils.sh"

DEV_VERSION="1.0.0"

show_version() {
    echo "devtool CLI version $DEV_VERSION"
    echo "Root directory: $DEV_ROOT_DIR"
}

show_help() {
    echo -e "${C_BOLD}${C_CYAN}DevTool CLI${C_RESET} — лаунчер сценариев для разработки и DevOps"
    echo
    echo -e "${C_BOLD}Использование:${C_RESET}"
    echo "  dev                                     Интерактивный запуск (через fzf или меню)"
    echo "  dev <category>                          Интерактивный выбор внутри категории"
    echo "  dev <category> <command> [аргументы...] Прямой запуск команды"
    echo "  dev <category>:<command> [аргументы...] Запуск через двоеточие"
    echo "  dev <category>-<command> [аргументы...] Запуск через дефис (например: dev git-sync)"
    echo
    echo -e "${C_BOLD}Системные команды:${C_RESET}"
    echo "  dev list [category]                     Список всех доступных скриптов"
    echo "  dev help <category> <command>           Подробная справка по команде"
    echo "  dev update                              Обновить devtool через git pull"
    echo "  dev doctor                              Проверить окружение и зависимости"
    echo
    echo -e "${C_BOLD}Флаги:${C_RESET}"
    echo "  -y, --yes, --force                      Пропустить подтверждение для опасных команд"
    echo "  -h, --help                              Показать эту справку"
    echo "  -v, --version                           Показать версию"
    echo
    echo -e "${C_BOLD}Категории скриптов:${C_RESET}"
    local categories
    mapfile -t categories < <(get_all_categories)
    for cat in "${categories[@]}"; do
        echo -e "  • ${C_GREEN}${cat}${C_RESET}"
    done
    echo
    echo -e "Примеры:"
    echo "  dev git sync main"
    echo "  dev docker clean"
    echo "  dev laravel reset --force"
    echo "  dev server health"
}

show_command_help() {
    local category="$1"
    local command_name="$2"

    local script_file
    script_file=$(resolve_script_path "$category" "$command_name") || {
        log_error "Команда '$category $command_name' не найдена."
        exit 1
    }

    local title desc usage dangerous
    title=$(get_metadata "$script_file" "name" "$category $command_name")
    desc=$(get_metadata "$script_file" "description" "Описание отсутствует")
    usage=$(get_metadata "$script_file" "usage" "dev $category $command_name")
    dangerous=$(get_metadata "$script_file" "dangerous" "false")

    echo -e "${C_BOLD}${C_CYAN}Справка по команде:${C_RESET} ${C_BOLD}${category} ${command_name}${C_RESET}"
    echo "────────────────────────────────────────────────────────"
    echo -e "${C_BOLD}Название:${C_RESET}     $title"
    echo -e "${C_BOLD}Категория:${C_RESET}    $category"
    echo -e "${C_BOLD}Описание:${C_RESET}     $desc"
    echo -e "${C_BOLD}Использование:${C_RESET}$usage"
    if [[ "$dangerous" == "true" ]]; then
        echo -e "${C_BOLD}Опасность:${C_RESET}    ${C_RED}Да (требуется подтверждение перед запуском)${C_RESET}"
    else
        echo -e "${C_BOLD}Опасность:${C_RESET}    ${C_GREEN}Нет (безопасный запуск)${C_RESET}"
    fi
    echo -e "${C_BOLD}Файл:${C_RESET}         ${C_DIM}$script_file${C_RESET}"
    echo "────────────────────────────────────────────────────────"
}

# Внутренняя функция для превью в fzf
show_fzf_preview() {
    local item="$1"
    local cat cmd
    IFS=':' read -r cat cmd _ <<< "$item"

    local script_file
    script_file=$(resolve_script_path "$cat" "$cmd") || return 0

    local title desc usage dangerous
    title=$(get_metadata "$script_file" "name" "$cat $cmd")
    desc=$(get_metadata "$script_file" "description" "Описание отсутствует")
    usage=$(get_metadata "$script_file" "usage" "dev $cat $cmd")
    dangerous=$(get_metadata "$script_file" "dangerous" "false")

    echo -e "\033[1;36m=== $title ($cat:$cmd) ===\033[0m"
    echo
    echo -e "\033[1mОписание:\033[0m    $desc"
    echo -e "\033[1mВызов:\033[0m       $usage"
    if [[ "$dangerous" == "true" ]]; then
        echo -e "\033[1;31mВнимание:    Опасная команда (требует подтверждения)!\033[0m"
    fi
    echo -e "\033[2mПуть:        $script_file\033[0m"
    echo
    echo -e "\033[1;33m--- Код скрипта (первые строки) ---\033[0m"
    head -n 25 "$script_file" | sed 's/^/  /'
}

list_commands() {
    local filter_category="${1:-}"
    local scripts
    mapfile -t scripts < <(get_all_scripts "$filter_category")

    if [[ ${#scripts[@]} -eq 0 ]]; then
        log_warn "Скрипты не найдены."
        return
    fi

    echo -e "${C_BOLD}${C_CYAN}Доступные команды devtool:${C_RESET}"
    echo -ne "  ${C_BOLD}"
    pad_to "КОМАНДА" 23
    pad_to "НАЗВАНИЕ" 24
    pad_to "ОПАСНО" 8
    echo -e "ОПИСАНИЕ${C_RESET}"
    echo "  ──────────────────────────────────────────────────────────────────────────────────────────────────"

    for entry in "${scripts[@]}"; do
        local cat cmd file
        IFS=':' read -r cat cmd file <<< "$entry"
        local title desc dangerous
        title=$(get_metadata "$file" "name" "$cmd")
        desc=$(get_metadata "$file" "description" "-")
        dangerous=$(get_metadata "$file" "dangerous" "false")

        local dang_text="нет"
        local dang_color="$C_GREEN"
        if [[ "$dangerous" == "true" ]]; then
            dang_text="ДА"
            dang_color="$C_RED"
        fi

        local full_cmd="${cat}:${cmd}"
        echo -ne "  ${C_BOLD}"
        pad_to "$full_cmd" 23
        echo -ne "${C_RESET}"
        pad_to "${title:0:22}" 24
        echo -ne "${dang_color}"
        pad_to "$dang_text" 8
        echo -e "${C_RESET}${C_DIM}${desc}${C_RESET}"
    done
    echo
}

# Интерактивный режим с fzf
interactive_fzf() {
    local filter_category="${1:-}"
    local scripts
    mapfile -t scripts < <(get_all_scripts "$filter_category")

    if [[ ${#scripts[@]} -eq 0 ]]; then
        log_warn "Нет доступных скриптов для выбора."
        exit 0
    fi

    local lines=()
    for entry in "${scripts[@]}"; do
        local cat cmd file
        IFS=':' read -r cat cmd file <<< "$entry"
        local desc
        desc=$(get_metadata "$file" "description" "")
        local key="${cat}:${cmd}"
        lines+=("$(printf "%-22s  │ %s" "$key" "$desc")")
    done

    local selected
    selected=$(printf "%s\n" "${lines[@]}" | fzf \
        --prompt="DevTool > " \
        --header="Выберите команду для запуска (Enter - запуск, Esc - выход)" \
        --preview="$DEV_ROOT_DIR/bin/dev _preview {1}" \
        --preview-window="right:55%:wrap" \
        --ansi)

    if [[ -z "$selected" ]]; then
        exit 0
    fi

    local picked_key
    picked_key=$(echo "$selected" | awk '{print $1}')
    local picked_cat picked_cmd
    IFS=':' read -r picked_cat picked_cmd <<< "$picked_key"

    execute_command "$picked_cat" "$picked_cmd"
}

# Запасной интерактивный режим (без fzf)
interactive_menu() {
    local filter_category="${1:-}"
    local scripts
    mapfile -t scripts < <(get_all_scripts "$filter_category")

    if [[ ${#scripts[@]} -eq 0 ]]; then
        log_warn "Нет доступных скриптов для выбора."
        exit 0
    fi

    echo -e "${C_BOLD}${C_CYAN}=== Меню DevTool CLI ===${C_RESET}"
    if [[ -z "$filter_category" ]]; then
        echo -e "${C_DIM}Выберите номер команды для запуска:${C_RESET}"
    else
        echo -e "${C_DIM}Категория: ${C_BOLD}${filter_category}${C_RESET}"
    fi
    echo

    local i=1
    for entry in "${scripts[@]}"; do
        local cat cmd file
        IFS=':' read -r cat cmd file <<< "$entry"
        local title desc dangerous
        title=$(get_metadata "$file" "name" "$cmd")
        desc=$(get_metadata "$file" "description" "")
        dangerous=$(get_metadata "$file" "dangerous" "false")

        local mark=""
        if [[ "$dangerous" == "true" ]]; then
            mark=" ${C_RED}[!]${C_RESET}"
        fi

        printf "  ${C_BOLD}%2d)${C_RESET} ${C_GREEN}%-18s${C_RESET}%b ${C_DIM}— %s${C_RESET}\n" \
            "$i" "${cat}:${cmd}" "$mark" "$desc"
        ((i++))
    done

    echo
    echo -e "  ${C_BOLD}q)${C_RESET} Выход"
    echo
    echo -e "${C_DIM}💡 Совет: установите fzf (sudo apt install fzf) для мгновенного интерактивного поиска!${C_RESET}"
    echo
    echo -n "Ваш выбор: "

    local choice
    read -r choice

    if [[ "$choice" == "q" ]] || [[ -z "$choice" ]]; then
        exit 0
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#scripts[@]} )); then
        local picked_entry="${scripts[$((choice-1))]}"
        local picked_cat picked_cmd
        IFS=':' read -r picked_cat picked_cmd _ <<< "$picked_entry"
        execute_command "$picked_cat" "$picked_cmd"
    else
        log_error "Неверный номер."
        exit 1
    fi
}

execute_command() {
    local category="$1"
    local command_name="$2"
    shift 2 || true

    local script_file
    # `resolve_script_path` returns 1 when no matching file exists.  Keep that
    # expected lookup failure out of `set -e` so we can show the useful error
    # below instead of silently terminating the launcher.
    script_file=$(resolve_script_path "$category" "$command_name") || script_file=""

    if [[ -z "$script_file" ]] || [[ ! -f "$script_file" ]]; then
        log_error "Команда не найдена: $category $command_name"
        echo "Запустите 'dev list' для просмотра доступных команд."
        exit 1
    fi

    # Проверка на опасность
    if ! confirm_if_dangerous "$script_file" "$category" "$command_name"; then
        exit 1
    fi

    # Запуск скрипта
    exec bash "$script_file" "$@"
}

# --- Разбор аргументов командной строки ---
DEV_FORCE=0

# Парсим глобальные опции в цикле
while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes|--force)
            DEV_FORCE=1
            export DEV_FORCE
            shift
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        _preview)
            shift
            show_fzf_preview "${1:-}"
            exit 0
            ;;
        list)
            shift
            list_commands "${1:-}"
            exit 0
            ;;
        help)
            shift
            if [[ $# -ge 2 ]]; then
                show_command_help "$1" "$2"
            else
                show_help
            fi
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

# Если аргументов нет — интерактивный запуск
if [[ $# -eq 0 ]]; then
    if command -v fzf >/dev/null 2>&1; then
        interactive_fzf
    else
        interactive_menu
    fi
    exit 0
fi

ARG1="$1"
ARG2="${2:-}"

# 1. Формат "category:command"
if [[ "$ARG1" == *":"* ]]; then
    CAT="${ARG1%%:*}"
    CMD="${ARG1##*:}"
    shift
    execute_command "$CAT" "$CMD" "$@"
fi

# 2. Формат "category-command" (например: git-sync, docker-clean, laravel-reset)
if [[ "$ARG1" == *"-"* ]]; then
    POSSIBLE_CAT="${ARG1%%-*}"
    POSSIBLE_CMD="${ARG1#*-}"
    if resolve_script_path "$POSSIBLE_CAT" "$POSSIBLE_CMD" >/dev/null 2>&1; then
        shift
        execute_command "$POSSIBLE_CAT" "$POSSIBLE_CMD" "$@"
    fi
fi

# 3. Формат "dev <category> <command>"
if [[ -n "$ARG2" ]] && [[ ! "$ARG2" =~ ^- ]]; then
    shift 2
    execute_command "$ARG1" "$ARG2" "$@"
fi

# 4. Формат "dev <command>" для системных утилит в scripts/dev/
if resolve_script_path "dev" "$ARG1" >/dev/null 2>&1; then
    shift
    execute_command "dev" "$ARG1" "$@"
fi

# 5. Если передан только один аргумент и это существующая категория — открываем меню категории
CATEGORIES_LIST=$(get_all_categories)
if echo "$CATEGORIES_LIST" | grep -qw "$ARG1"; then
    if command -v fzf >/dev/null 2>&1; then
        interactive_fzf "$ARG1"
    else
        interactive_menu "$ARG1"
    fi
    exit 0
fi

# 6. Если передан одиночный скрипт, ищем его в любой категории
MATCHING_SCRIPTS=()
while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    IFS=':' read -r c m _ <<< "$entry"
    if [[ "$m" == "$ARG1" ]]; then
        MATCHING_SCRIPTS+=("$c:$m")
    fi
done < <(get_all_scripts)

if [[ ${#MATCHING_SCRIPTS[@]} -eq 1 ]]; then
    IFS=':' read -r c m <<< "${MATCHING_SCRIPTS[0]}"
    shift
    execute_command "$c" "$m" "$@"
elif [[ ${#MATCHING_SCRIPTS[@]} -gt 1 ]]; then
    log_warn "Найдено несколько команд с именем '$ARG1':"
    for match in "${MATCHING_SCRIPTS[@]}"; do
        echo "  - dev ${match/:/ }"
    done
    echo "Пожалуйста, уточните категорию."
    exit 1
fi

log_error "Неизвестная команда или категория: '$ARG1'"
echo "Запустите 'dev list' для просмотра всех доступных команд или 'dev --help'."
exit 1
